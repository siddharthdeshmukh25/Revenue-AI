# --- Supabase ---
# Get your credentials from https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
DB_PASSWORD=DB_PASSWORD

# --- Groq (LLM) ---
# https://console.groq.com/keys
# FREE MODELS (No cost, very fast):
# - llama-3.1-8b-instant (Fastest, free)
# - llama-3.1-70b-versatile (Free tier)
# - mixtral-8x7b-32768 (Free tier)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# --- Business rules (stopping rules) ---
MAX_INTERVENTION_ATTEMPTS=2

# --- FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Used by the frontend to call the backend
# Local development: http://localhost:8000
# Railway production: https://your-backend-name.up.railway.app
BACKEND_URL=http://localhost:8000
