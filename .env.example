# --- Supabase ---
# Project Settings -> API -> Project URL / service_role key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# --- OpenRouter (LLM) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# Alternatives: anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-70b-instruct

# --- Business rules (stopping rules) ---
MAX_INTERVENTION_ATTEMPTS=2

# --- FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Used by the Streamlit frontend to call the FastAPI backend
BACKEND_URL=http://localhost:8000
